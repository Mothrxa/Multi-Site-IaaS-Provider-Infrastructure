-- /var/cache/bind/db.pfe2627.xyz --
$ORIGIN .
$TTL 604800     ; 1 week
pfe2627.xyz             IN SOA  ns1.pfe2627.xyz. admin.pfe2627.xyz. (
                                16         ; serial
                                604800     ; refresh (1 week)
                                86400      ; retry (1 day)
                                2419200    ; expire (4 weeks)
                                604800     ; minimum (1 week)
                                )
                        NS      ns1.pfe2627.xyz.
                        MX      10 mail.pfe2627.xyz.
$ORIGIN pfe2627.xyz.
