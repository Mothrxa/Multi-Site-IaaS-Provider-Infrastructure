                                      that Postfix uses for things like aliases, access rules, and routing.

# Create a system user to OWN all mail (not for login)
sudo groupadd -g 5000 vmail
sudo useradd -g vmail -u 5000 vmail -d /var/mail/vmail -s /usr/sbin/nologin
sudo mkdir -p /var/mail/vmail
sudo chown -R vmail:vmail /var/mail/vmail

