PORT=3001
CORS_ORIGIN=http://localhost:5173

# Portal DB
DATABASE_URL=postgres://<USER>:<PASSWORD>@localhost:5432/portal
# Cloud DB (same server, separate database)
CLOUD_DATABASE_URL=postgres://<USER>:<PASSWORD>@localhost:5432/cloud

# Mail server (co-located with web server)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false

IMAP_HOST=localhost
IMAP_PORT=143
IMAP_SECURE=false

# IMAP folder names (adjust to match your mail server)
IMAP_FOLDER_INBOX=INBOX
IMAP_FOLDER_SENT=Sent
IMAP_FOLDER_DRAFTS=Drafts
IMAP_FOLDER_TRASH=Trash
IMAP_FOLDER_ARCHIVE=Archive

JWT_SECRET=<SECRET>
JWT_EXPIRES=8h

# Mail domain
MAIL_DOMAIN=pfe2627.xyz
MAIL_BASE=/var/mail/vmail
POSTFIX_VMAILBOX=/etc/postfix/vmailbox
DOVECOT_PASSWD=/etc/dovecot/users

# Employee files root — /var/files/$USER/payslip/ for payslips, Work_Certificate.pdf at root
EMPLOYEE_FILES_DIR=/var/files

# Set to true for local dev without a real mail/auth backend
MOCK_AUTH=true
MOCK_MAIL=true
